<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel do Motorista | Aluga Fácil</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f5f7f9;
            color: #222;
        }

        header {
            background: #111827;
            color: white;
            padding: 20px;
        }

        header h1 {
            margin: 0;
            font-size: 24px;
        }

        .container {
            max-width: 1100px;
            margin: 30px auto;
            padding: 0 20px;
        }

        .topo,
        .solicitacao,
        .vazio {
            background: white;
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 20px;
        }

        .solicitacao {
            box-shadow: 0 2px 8px rgba(0,0,0,0.08);
        }

        .status {
            display: inline-block;
            padding: 7px 13px;
            border-radius: 20px;
            background: #fff3cd;
            color: #856404;
            margin-bottom: 15px;
        }

        .info {
            margin: 9px 0;
        }

        .whatsapp {
            display: inline-block;
            margin-top: 8px;
            padding: 9px 14px;
            background: #25D366;
            color: white;
            text-decoration: none;
            border-radius: 7px;
        }

        .erro {
            background: #f8d7da;
            color: #842029;
            padding: 15px;
            border-radius: 8px;
        }
    </style>
</head>

<body>

<header>
    <h1>Aluga Fácil Veículos</h1>
</header>

<div class="container">

    <div class="topo">
        <h2>👨‍✈️ Painel do Motorista</h2>
        <p id="usuario-logado">Carregando...</p>
    </div>

    <h2>📩 Minhas solicitações</h2>

    <div id="lista-solicitacoes">
        <p>Carregando solicitações...</p>
    </div>

</div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

<script>

const SUPABASE_URL = "https://clgwzlljyauqezdogeiq.supabase.co";

const SUPABASE_KEY = "sb_publishable_g_BCrMrWOq9sEt9LLJIyeA_YeNv4YDA";

const supabaseClient = supabase.createClient(
    SUPABASE_URL,
    SUPABASE_KEY
);

async function carregarPainel() {

    const usuarioLogado = document.getElementById("usuario-logado");
    const lista = document.getElementById("lista-solicitacoes");

    const {
        data: { user },
        error: erroLogin
    } = await supabaseClient.auth.getUser();

    if (erroLogin || !user) {

        usuarioLogado.textContent =
            "Você precisa estar logado para acessar este painel.";

        lista.innerHTML = `
            <div class="erro">
                Faça login para visualizar suas solicitações.
            </div>
        `;

        return;
    }

    usuarioLogado.textContent =
        "Usuário logado: " + user.email;

    const { data: solicitacoes, error } = await supabaseClient
        .from("solicitacoes_locacao")
        .select("*")
        .eq("motorista_id", user.id)
        .order("created_at", { ascending: false });

    if (error) {

        console.error(error);

        lista.innerHTML = `
            <div class="erro">
                Não foi possível carregar suas solicitações.
            </div>
        `;

        return;
    }

    if (!solicitacoes || solicitacoes.length === 0) {

        lista.innerHTML = `
            <div class="vazio">
                <h3>📭 Nenhuma solicitação</h3>
                <p>
                    Quando você demonstrar interesse em um veículo,
                    sua solicitação aparecerá aqui.
                </p>
            </div>
        `;

        return;
    }

    const solicitacoesComDados = await Promise.all(

        solicitacoes.map(async (solicitacao) => {

            const { data: veiculo } = await supabaseClient
                .from("veiculos")
                .select("marca, modelo, versao, ano, cidade")
                .eq("id", solicitacao.veiculo_id)
                .single();

            let proprietario = null;

            if (solicitacao.status === "aceito") {

                const { data } = await supabaseClient
                    .rpc(
                        "obter_dados_contato_usuario",
                        {
                            p_usuario_id: solicitacao.proprietario_id
                        }
                    );

                proprietario = data?.[0] || null;
            }

            return {
                ...solicitacao,
                veiculo,
                proprietario
            };
        })
    );

    lista.innerHTML = solicitacoesComDados.map(solicitacao => `

        <div class="solicitacao">

            <span class="status">
                ${solicitacao.status || "pendente"}
            </span>

            <h3>🚗 Solicitação de aluguel</h3>

            <div class="info">
                <strong>🚗 Veículo:</strong>
                ${(solicitacao.veiculo?.marca || "") + " " +
                  (solicitacao.veiculo?.modelo || "") + " " +
                  (solicitacao.veiculo?.versao || "")}
            </div>

            <div class="info">
                <strong>📅 Ano:</strong>
                ${solicitacao.veiculo?.ano || "Não informado"}
            </div>

            <div class="info">
                <strong>📍 Cidade:</strong>
                ${solicitacao.veiculo?.cidade || "Não informada"}
            </div>

            <div class="info">
                <strong>📅 Data de início:</strong>
                ${solicitacao.data_inicio || "Não informada"}
            </div>

            <div class="info">
                <strong>📅 Data de término:</strong>
                ${solicitacao.data_fim || "Não informada"}
            </div>

            <div class="info">
                <strong>💬 Sua mensagem:</strong><br>
                ${solicitacao.mensagem || "Nenhuma mensagem enviada."}
            </div>

            ${
                solicitacao.status === "aceito"
                ? `
                    <hr>

                    <h3>👤 Dados do proprietário</h3>

                    <div class="info">
                        <strong>Nome:</strong>
                        ${solicitacao.proprietario?.nome || "Não informado"}
                    </div>

                    <div class="info">
                        <strong>📱 Telefone:</strong>
                        ${solicitacao.proprietario?.telefone || "Não informado"}
                    </div>

                    <div class="info">
                        <strong>📍 Cidade:</strong>
                        ${solicitacao.proprietario?.cidade || "Não informada"}
                    </div>

                    ${
                        solicitacao.proprietario?.whatsapp
                        ? `
                            <a
                                class="whatsapp"
                                href="https://wa.me/55${solicitacao.proprietario.whatsapp.replace(/\D/g, '')}"
                                target="_blank">
                                🟢 Chamar proprietário no WhatsApp
                            </a>
                        `
                        : ""
                    }
                `
                : `
                    <p>
                        ⏳ Aguardando resposta do proprietário.
                    </p>
                `
            }

        </div>

    `).join("");
}

document.addEventListener(
    "DOMContentLoaded",
    carregarPainel
);

</script>

</body>
</html>
